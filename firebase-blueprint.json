{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID" },
        "displayName": { "type": "string", "description": "Public name" },
        "email": { "type": "string", "description": "Email address" },
        "pseudonym": { "type": "string", "description": "Anonymous alias" },
        "bio": { "type": "string", "description": "Biography" },
        "language": { "type": "string", "description": "Language code en or bn" },
        "role": { "type": "string", "description": "User role: user or admin" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["userId", "displayName", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Community post for vent, discussion, or price talk",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Post document ID" },
        "authorId": { "type": "string", "description": "Auth UID of the author" },
        "authorName": { "type": "string", "description": "Display name or Anonymous" },
        "isAnonymous": { "type": "boolean", "description": "True if posted anonymously" },
        "pseudonym": { "type": "string", "description": "Pseudonym displayed if anonymous" },
        "title": { "type": "string", "description": "Title of the post" },
        "content": { "type": "string", "description": "Content of the post" },
        "postType": { "type": "string", "description": "VENT, DISCUSSION, or PRICE_TALK" },
        "category": { "type": "string", "description": "Category name" },
        "moodTag": { "type": "string", "description": "Mood: ANGRY, FRUSTRATED, SAD, CONFUSED, NEED_SUPPORT, NONE" },
        "ventMode": { "type": "string", "description": "JUST_LISTEN or ADVICE_WELCOME" },
        "supportiveCount": { "type": "integer", "description": "Count of supportive reactions" },
        "helpfulCount": { "type": "integer", "description": "Count of helpful reactions" },
        "commentCount": { "type": "integer", "description": "Count of comments" },
        "priceQuoted": { "type": "number", "description": "Quoted price in BDT" },
        "priceFair": { "type": "number", "description": "Fair price in BDT" },
        "priceLocation": { "type": "string", "description": "Location or city" },
        "priceCondition": { "type": "string", "description": "Condition: New or Used" },
        "brandModel": { "type": "string", "description": "Brand and model" },
        "pollQuestion": { "type": "string", "description": "Poll question" },
        "pollOptions": { "type": "string", "description": "Comma separated options" },
        "pollVotes": { "type": "string", "description": "Comma separated votes" },
        "isHidden": { "type": "boolean", "description": "Moderation hide status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["id", "authorId", "title", "content", "postType", "category", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment or empathetic response on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Comment ID" },
        "postId": { "type": "string", "description": "Target post ID" },
        "authorId": { "type": "string", "description": "Author UID" },
        "authorName": { "type": "string", "description": "Author display name" },
        "isAnonymous": { "type": "boolean", "description": "True if anonymous" },
        "pseudonym": { "type": "string", "description": "Author pseudonym" },
        "content": { "type": "string", "description": "Text of the comment" },
        "supportiveCount": { "type": "integer", "description": "Reactions count" },
        "isAiResponse": { "type": "boolean", "description": "True if generated by AI" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" }
      },
      "required": ["id", "postId", "authorId", "content", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User alert for replies and reactions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "userId": { "type": "string", "description": "Recipient UID" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification text" },
        "type": { "type": "string", "description": "Type: SUPPORT, COMMENT, AI, ADMIN" },
        "relatedPostId": { "type": "string", "description": "Associated post ID" },
        "isRead": { "type": "boolean", "description": "Read status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp via serverTimestamp" }
      },
      "required": ["id", "userId", "title", "message", "type", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Content moderation report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Report ID" },
        "reporterId": { "type": "string", "description": "UID of reporter" },
        "postId": { "type": "string", "description": "Reported post ID" },
        "postTitle": { "type": "string", "description": "Reported post title" },
        "reportedAuthor": { "type": "string", "description": "Author name" },
        "reason": { "type": "string", "description": "Violation reason" },
        "details": { "type": "string", "description": "Additional context" },
        "status": { "type": "string", "description": "PENDING, RESOLVED, or DISMISSED" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" }
      },
      "required": ["id", "reporterId", "postId", "reason", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles and settings"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "Post" },
      "description": "Public community vents, discussions, and price talks"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "Comment" },
      "description": "Comments and replies on community posts"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "Notification" },
      "description": "User notifications"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "Report" },
      "description": "Moderation reports queue"
    }
  }
}
